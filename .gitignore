# ==============================================================================
# Roofline Relay — Safe Version Control Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Secrets, Environment & Credentials (NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.key
*.pem
*.pfx
*.p12
id_rsa*
id_ed25519*
secrets.json
credentials.json
# Preserve safe example files
!.env.example

# ------------------------------------------------------------------------------
# Operating System & Filesystem Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# Editor & IDE Workspaces
# ------------------------------------------------------------------------------
.vs/
.idea/
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# 3D Software Backup Files (Blender / Maya / 3ds Max)
# ------------------------------------------------------------------------------
*.blend1
*.blend2
*.blend3
*.blend@
*.blend@@
*~
*.bak

# ------------------------------------------------------------------------------
# Unity Engine Temporary, Cache & Build Directories (Recursive)
# ------------------------------------------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Aa]sset[Cc]ache/
[Rr]ecordings/
sysinfo.txt
*.apk
*.aab
*.unitypackage

# Autogenerated Solution and Project files
*.csproj
*.unityproj
*.sln
*.slnx
*.tmp
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta

# ------------------------------------------------------------------------------
# Godot Engine Cache & Export Artifacts
# ------------------------------------------------------------------------------
.godot/
*.translation

# ------------------------------------------------------------------------------
# Python & Scratch Script Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# ------------------------------------------------------------------------------
# Temporary Downloads & Staging (Avoid pushing intermediate download caches)
# ------------------------------------------------------------------------------
[Tt]emp/
[Tt]mp/
scratch/
*.log

# ------------------------------------------------------------------------------
# Test-Only Scenes, Test Harnesses & Development Video Captures
# ------------------------------------------------------------------------------
unity-game/Assets/Scenes/CharacterAnimationTest.unity
unity-game/Assets/Scenes/CharacterAnimationTest.unity.meta
unity-game/Assets/Scripts/Character/CharacterAnimationTestHarness.cs
unity-game/Assets/Scripts/Character/CharacterAnimationTestHarness.cs.meta
docs/demo/*.mp4
*.mp4

# Intermediate decimation GLB files in unity-game superseded by native Unity FBX
unity-game/Assets/Art/Characters/*_lod.glb
unity-game/Assets/Art/Characters/*_lod.glb.meta
unity-game/Assets/Art/Environment/*_lod.glb
unity-game/Assets/Art/Environment/*_lod.glb.meta
unity-game/Assets/Art/Props/*_lod.glb
unity-game/Assets/Art/Props/*_lod.glb.meta
